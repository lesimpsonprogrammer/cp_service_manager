# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the browser. Used by webhook/API routes that need
# to bypass RLS (e.g. resolving an org from an API key or inbound webhook token).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL of this app (used to build inbound webhook URLs, email redirects, etc.)
NEXT_PUBLIC_APP_URL=https://app.momentumdatasolutions.com

# Resend (https://resend.com) — sends contract signing links, reminders, and
# signed-notification emails. Without these set, the app logs a warning and
# skips sending instead of failing.
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=notifications@yourdomain.com

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` when it
# triggers /api/cron/contract-reminders (see vercel.json). Any random string;
# generate one with `openssl rand -hex 32`.
CRON_SECRET=your-cron-secret
