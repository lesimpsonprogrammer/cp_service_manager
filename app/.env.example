# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the browser. Used by webhook/API routes that need
# to bypass RLS (e.g. resolving an org from an API key or inbound webhook token).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL of this app (used to build inbound webhook URLs, email redirects, etc.)
NEXT_PUBLIC_APP_URL=https://app.cpservicemanager.com
